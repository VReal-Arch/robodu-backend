# ================================================
# ROBODU backend - konfigurasi PRODUKSI
# Node.js di Hostinger | PostgreSQL di Supabase | MQTT di HiveMQ Cloud
# Salin jadi .env lalu isi nilainya. JANGAN commit file .env ke GitHub.
# ================================================

# --- Port ---
# Hostinger mengisi PORT sendiri. Biarkan kosong / jangan di-set di produksi.
# PORT=4000

# --- MQTT: HiveMQ Cloud ---
# Ambil dari HiveMQ Console > Cluster > Overview.
# Wajib pakai skema mqtts:// (TLS) dan port 8883.
MQTT_URL=mqtts://xxxxxxxxxxxx.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=isi_username_hivemq
MQTT_PASSWORD=isi_password_hivemq

# --- PostgreSQL: Supabase ---
# Supabase Dashboard > Project Settings > Database > Connection string > URI.
# Pakai connection pooler (port 6543) supaya hemat koneksi.
# Ganti [YOUR-PASSWORD] dengan password database yang kamu buat.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- Lain-lain ---
# Waktu tunggu sebelum robot dianggap putus (ms).
WATCHDOG_TIMEOUT_MS=3000
# Prefix topic MQTT. Harus SAMA dengan yang dipakai firmware ESP32.
TOPIC_PREFIX=robodu
